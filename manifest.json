{
  "manifest_version": 3,
  "name": "Kimi Auto Paste & Retry",
  "version": "1.0",
  "description": "Cola automaticamente o conteúdo da área de transferência no campo de prompt do Kimi e reenvia caso apareça o aviso de fila de espera.",
  "permissions": ["clipboardRead", "storage"],
  "host_permissions": ["*://*.kimi.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.kimi.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kimi Auto Paste & Retry"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kimi-auto-paste@local.ext",
      "strict_min_version": "109.0"
    }
  }
}
